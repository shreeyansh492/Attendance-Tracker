<Window x:Class="Tracker.View.AutoCheckoutWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tracker.View"
        mc:Ignorable="d"
        Title="AutoCheckoutWarningWindow"  Width="460"
 Height="316"
 WindowStartupLocation="CenterScreen"
 ResizeMode="NoResize"
 WindowStyle="None"
 Topmost="True"
 ShowInTaskbar="False"
 Background="Transparent"
 AllowsTransparency="True">
    <Border Margin="12"
            Padding="26"
            CornerRadius="18"
            Background="{StaticResource WizeSurfaceBrush}"
            BorderBrush="{StaticResource WizeWarningBrush}"
            BorderThickness="2">

        <StackPanel Margin="0,0,0,-20">

            <TextBlock Text="⚠"
                       FontSize="42"
                       TextAlignment="Center"
                       Foreground="{StaticResource WizeWarningBrush}"
                       Margin="0,0,0,10" />

            <TextBlock Text="{Binding Title}"
                       FontSize="24"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,8" />

            <TextBlock Text="{Binding Message}"
                       FontSize="14"
                       Foreground="{StaticResource WizeMutedTextBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14" />

            <TextBlock Text="{Binding RemainingTimeText}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource WizeWarningBrush}"
                       TextAlignment="Center"
                       Margin="0,0,0,20" />

            <Button x:Name="ContinueWorking"
                    Content="OK"
                    Height="38"
                    Width="130"
                    HorizontalAlignment="Center"
                   
                    Click="ContinueWorkingButton_OnClick" />

        </StackPanel>
    </Border>
</Window>
