<Window x:Class="Tracker.View.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tracker.View"
        mc:Ignorable="d"
        Title="DiagnosticsWindow" Width="978"
Height="727"
WindowStartupLocation="CenterScreen"
Background="{StaticResource WizeBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Margin="0,0,0,14">

            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Diagnostics"
                           FontSize="26"
                           FontWeight="Bold" />

                <TextBlock Text="Production-safe app status and latest logs"
                           FontSize="13"
                           Foreground="{StaticResource WizeMutedTextBrush}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">


                <CheckBox Grid.Column="1"
                        Content="Auto scroll"
                        IsChecked="True"
                        Name="AutoScrollCheck"
                        Foreground="White"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0" />

                <Button Content="Refresh"
                        Width="110"
                        Margin="8,0,0,0"
                        Click="RefreshButton_OnClick" />

                <Button Content="Clear"
                        Width="110"
                        Margin="8,0,0,0"
                        Click="ClearButton_OnClick" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Background="{StaticResource WizeSurfaceBrush}"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="App State"
                               Foreground="{StaticResource WizeMutedTextBrush}" />
                    <TextBlock Text="{Binding AppState}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,2,0,10" />

                    <TextBlock Text="Employee"
                               Foreground="{StaticResource WizeMutedTextBrush}" />
                    <TextBlock Text="{Binding EmployeeName}"
                               FontSize="15"
                               Margin="0,2,0,2" />

                    <TextBlock Text="{Binding EmployeeEmail}"
                               FontSize="12"
                               Foreground="{StaticResource WizeMutedTextBrush}"
                               Margin="0,0,0,10" />

                    <TextBlock Text="Pending Offline Queue"
                               Foreground="{StaticResource WizeMutedTextBrush}" />
                    <TextBlock Text="{Binding PendingOfflineCount}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Machine Identifier"
                               Foreground="{StaticResource WizeMutedTextBrush}" />
                    <TextBlock Text="{Binding MachineIdentifier}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,2,0,10" />

                    <TextBlock Text="Machine Name"
                               Foreground="{StaticResource WizeMutedTextBrush}" />
                    <TextBlock Text="{Binding MachineName}"
                               FontSize="14"
                               Margin="0,2,0,10" />

                    <TextBlock Text="API Base URL"
                               Foreground="{StaticResource WizeMutedTextBrush}" />
                    <TextBlock Text="{Binding ApiBaseUrl}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,2,0,10" />

                    <TextBlock Text="Last Heartbeat"
                               Foreground="{StaticResource WizeMutedTextBrush}" />
                    <TextBlock Text="{Binding LastHeartbeat}"
                               FontSize="14"
                               Margin="0,2,0,10" />

                    <TextBlock Text="Last Refreshed"
                               Foreground="{StaticResource WizeMutedTextBrush}" />
                    <TextBlock Text="{Binding LastRefreshedAt}"
                               FontSize="14"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#020617"
                CornerRadius="12"
                Padding="12" Margin="0,0,0,21">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Latest Logs"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <ListBox Grid.Row="1"
                         x:Name="LogListBox"
                         ItemsSource="{Binding LogLines}"
                         Background="#020617"
                         Foreground="#E5E7EB"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource WizeDangerBrush}"
                   FontSize="12"
                   Margin="0,10,0,0" />
    </Grid>
</Window>
