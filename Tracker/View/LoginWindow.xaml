<Window x:Class="Tracker.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attendance Login"
       ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Topmost="True"
        Background="{StaticResource WizeBackgroundBrush}"
       >

    <Grid>
        <!-- Full background -->
        <Rectangle Fill="#0D0D1A"/>

        <!-- Subtle dot pattern -->
        <Rectangle Opacity="0.04">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile"
                    Viewport="0,0,20,20"
                    ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="White">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry
                                    Center="10,10"
                                    RadiusX="1"
                                    RadiusY="1"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Border CornerRadius="18"
            Background="{StaticResource WizeSurfaceBrush}"
            Padding="36,32"
           
                Width="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="40"
                    Opacity="0.5"
                    ShadowDepth="0"
                    Color="Black">

                </DropShadowEffect>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,24">

                    <Border Width="70"
        Height="70"
       
        CornerRadius="8"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">

                        <Image Source="/Assets/Logo.png"
           Width="52"
           Height="52"
           Stretch="Uniform"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="{Binding Title}"
                           FontSize="24"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,18,0,4" />

                    <TextBlock Text="{Binding Subtitle}"
                           FontSize="13"
                           TextAlignment="Center"
                           Foreground="{StaticResource WizeMutedTextBrush}"
                           TextWrapping="Wrap"
                           Width="320" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                        VerticalAlignment="Center">

                    <TextBlock Text="Email"
                           FontSize="13"
                           Foreground="{StaticResource WizeMutedTextBrush}" />


                    <TextBox x:Name="EmailTextBox"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        
                         Background="#12121E"
                         Foreground="White"
                         BorderThickness="1,1,1,1"
                         CaretBrush="White"
                         KeyDown="EmailTextBox_KeyDown"/>


                    <TextBlock Text="PIN (4 digits)"
                           FontSize="13"
                           Foreground="{StaticResource WizeMutedTextBrush}" />
                    <Border>



                        <PasswordBox x:Name="PinPasswordBox"
                             
                            MaxLength="4"
                            PasswordChar="●"
                            KeyDown="PinPasswordBox_OnKeyDown"
                            Background="#12121E"
                            Foreground="White" Height="37" Width="308" Password=""/>



                    </Border>



                    <Button x:Name="LoginButton"
                        Content="Login"
                        Height="44"
                        Click="LoginButton_OnClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                CornerRadius="8"
                Padding="{TemplateBinding Padding}">
                                    <ContentPresenter
                HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                     Value="True">
                                        <Setter TargetName="Bd"
                        Property="Background"
                        Value="#4752C4"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled"
                     Value="False">
                                        <Setter TargetName="Bd"
                        Property="Background"
                        Value="#2A2A3E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource WizeSuccessBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />

                    <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource WizeDangerBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0">

                    <TextBlock Text="Developed And Maintained By"
                           FontSize="11"
                           Foreground="{StaticResource WizeMutedTextBrush}"
                           TextAlignment="Center" />

                    <TextBlock Text="© Your Company Name"
                           FontSize="11"
                           Foreground="{StaticResource WizeMutedTextBrush}"
                           TextAlignment="Center"
                           Margin="0,6,0,0" />
                    <!-- Temporary close button for testing -->

                    <Button Click="Close_Click"
        Content="⏹ CLOSE!!!"
        Background="#1A0A0A"
       
        BorderBrush="#2A1515"
        BorderThickness="1"
        Padding="0,8"
        FontSize="11"
        FontWeight="SemiBold"
        Cursor="Hand">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">

                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd"
                            Property="Background"
                            Value="#2A0D0D"/>
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd"
                            Property="Background"
                            Value="#3A1010"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>