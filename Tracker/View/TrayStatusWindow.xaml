<Window x:Class="Tracker.View.TrayStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tracker.View"
        mc:Ignorable="d"
        Title="TrayStatusWindow"  Width="423"
 Height="433"
 WindowStartupLocation="CenterScreen"
 ResizeMode="NoResize"
 Background="{StaticResource WizeBackgroundBrush}">
    <Border Margin="16"
            Padding="22"
            CornerRadius="16"
            Background="{StaticResource WizeSurfaceBrush}">

        <StackPanel Margin="0,0,4,-27">

            <TextBlock Text="Attendance Tracker"
                       FontSize="22"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,4" />

            <TextBlock Text="Current agent status"
                       FontSize="13"
                       Foreground="{StaticResource WizeMutedTextBrush}"
                       TextAlignment="Center"
                       Margin="0,0,0,22" />

            <TextBlock Text="State"
                       Foreground="{StaticResource WizeMutedTextBrush}" />

            <TextBlock Text="{Binding StateText}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,3,0,14" />

            <TextBlock Text="Employee"
                       Foreground="{StaticResource WizeMutedTextBrush}" />

            <TextBlock Text="{Binding EmployeeText}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,3,0,14" />

            <TextBlock Text="Designation"
           Foreground="{StaticResource WizeMutedTextBrush}" />

            <TextBlock Text="{Binding DesignationText}"
                        FontSize="14"
                        TextWrapping="Wrap"
                        Margin="0,3,0,18" />

            <TextBlock Text="Department"
                        Foreground="{StaticResource WizeMutedTextBrush}" />

            <TextBlock Text="{Binding DepartmentText}"
                        FontSize="14"
                        TextWrapping="Wrap"
                        Margin="0,3,0,18" />

            <Button Content="Refresh"
                        Height="40"
                        Click="RefreshButton_OnClick" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource WizeDangerBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />

        </StackPanel>
    </Border>
</Window>
