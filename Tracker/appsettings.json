{
  "App": {
    "Name": "WizeVision Attendance Agent",
    "CompanyTimeZone": "Asia/Kolkata",
    "Environment": "Production"
  },

  "Api": {
    "BaseUrl": "localhost:8080",
    "WindowsAppKey": "8f3a9b2c7d1e0f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a",
